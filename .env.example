PORT=5000
NODE_ENV=development

DB_URL="mongodb://localhost:27017"

# Deployed Next.js frontend URL. Used for CORS and Stripe success/cancel redirects.
CLIENT_URL="http://localhost:3000"
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Stripe (server-side only — leave the secret empty to disable checkout)
STRIPE_SECRET_KEY=""
# Register POST /api/v1/payment/webhook in the Stripe dashboard (or use Stripe CLI)
STRIPE_WEBHOOK_SECRET=""
